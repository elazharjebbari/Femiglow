// FemiGlow Chat — Motion Design Tokens
// Format HJSON (commentaires + trailing commas autorisés)
// Source de vérité pour les animations Framer Motion + CSS transitions

{
  // ──────────────────────────────────────
  // Durées (ms) — cohérentes avec Material 3
  // ──────────────────────────────────────
  durations: {
    instant: 0
    micro: 80          // hover, focus rings
    short: 150         // small UI state changes
    medium: 250        // sheet open, modal in
    long: 400          // sheet close, page transitions
    xlong: 650         // celebration, confetti
  }

  // ──────────────────────────────────────
  // Easings
  // ──────────────────────────────────────
  easings: {
    // Standard Material
    standard: "cubic-bezier(0.4, 0.0, 0.2, 1)"
    standardDecel: "cubic-bezier(0.0, 0.0, 0.2, 1)"
    standardAccel: "cubic-bezier(0.4, 0.0, 1, 1)"

    // FemiGlow signature : doux, féminin, jamais sec
    feminine: "cubic-bezier(0.34, 1.16, 0.64, 1)"     // overshoot léger
    soft: "cubic-bezier(0.25, 0.1, 0.25, 1)"          // ultra-doux

    // Spring équivalents (pour Framer Motion)
    spring: {
      stiffness: 220
      damping: 24
      mass: 0.9
    }
    springSoft: {
      stiffness: 150
      damping: 22
      mass: 1.0
    }
  }

  // ──────────────────────────────────────
  // Composants spécifiques
  // ──────────────────────────────────────
  components: {

    // ChatLauncher — bouton flottant
    launcher: {
      enter: {
        opacity: { from: 0, to: 1, duration: "medium", easing: "standardDecel" }
        scale:   { from: 0.5, to: 1, duration: "medium", easing: "feminine" }
        translateY: { from: 20, to: 0, duration: "medium", easing: "standardDecel" }
      }
      pulse: {
        // Pulse subtile quand unread > 0 (1× toutes 3s)
        scale: [1, 1.05, 1]
        duration: "long"
        repeat: "infinite"
        repeatDelay: 3000
        easing: "soft"
      }
      hover: {
        scale: 1.05
        duration: "short"
        easing: "standard"
      }
    }

    // ChatPanel — sheet/modal
    panel: {
      enter: {
        // Mobile : slide-up depuis bas
        mobile: {
          translateY: { from: "100%", to: "0%", duration: "medium", easing: "standardDecel" }
          opacity: { from: 0, to: 1, duration: "short" }
        }
        // Desktop : fade + scale léger
        desktop: {
          opacity: { from: 0, to: 1, duration: "medium", easing: "standardDecel" }
          scale: { from: 0.96, to: 1, duration: "medium", easing: "feminine" }
          translateY: { from: 12, to: 0, duration: "medium", easing: "standardDecel" }
        }
      }
      exit: {
        mobile: {
          translateY: { from: "0%", to: "100%", duration: "long", easing: "standardAccel" }
          opacity: { from: 1, to: 0, duration: "medium" }
        }
        desktop: {
          opacity: { from: 1, to: 0, duration: "medium", easing: "standardAccel" }
          scale: { from: 1, to: 0.96, duration: "medium", easing: "standardAccel" }
        }
      }
    }

    // MessageBubble — entrée d'une bulle
    bubble: {
      enter: {
        // Différé pour effet "cascade" si plusieurs bulles
        opacity: { from: 0, to: 1, duration: "short", easing: "standardDecel" }
        translateY: { from: 8, to: 0, duration: "short", easing: "feminine" }
        // RTL : translateX au lieu d'Y pour effet "depuis le bord"
        rtlTranslateX: { from: 12, to: 0, duration: "short", easing: "feminine" }
      }
      staggerChildren: 50    // ms entre bulles si batch arrival
    }

    // TypingDots — 3 points pulsants
    typingDots: {
      dot: {
        opacity: [0.3, 1, 0.3]
        translateY: [0, -3, 0]
        duration: 900
        repeat: "infinite"
        easing: "soft"
      }
      stagger: 180    // ms entre points
    }

    // SuggestionPills — apparition
    pills: {
      enter: {
        staggerChildren: 80
        opacity: { from: 0, to: 1, duration: "short" }
        translateY: { from: 6, to: 0, duration: "short", easing: "feminine" }
      }
      hover: {
        scale: 1.03
        duration: "micro"
      }
      tap: {
        scale: 0.97
        duration: 60
      }
    }

    // LeadForm — slide in
    leadForm: {
      enter: {
        height: { from: 0, to: "auto", duration: "medium", easing: "standardDecel" }
        opacity: { from: 0, to: 1, duration: "medium", delay: 100 }
      }
      exit: {
        height: { from: "auto", to: 0, duration: "short", easing: "standardAccel" }
        opacity: { from: 1, to: 0, duration: "short" }
      }
    }

    // Streaming caret — clignote pendant que les tokens arrivent
    streamingCaret: {
      opacity: [1, 0, 1]
      duration: 1000
      repeat: "infinite"
      easing: "linear"
    }

    // ServiceLevel toast — apparait si dégradation
    serviceLevelToast: {
      enter: {
        translateY: { from: -40, to: 0, duration: "medium", easing: "feminine" }
        opacity: { from: 0, to: 1, duration: "short" }
      }
      autoHideAfter: 5000
    }

    // FeedbackButtons thumbs animation
    thumb: {
      tap: {
        scale: [1, 0.8, 1.3, 1]
        duration: 400
        easing: "feminine"
      }
      activated: {
        rotate: [0, -10, 10, 0]
        duration: 350
        easing: "feminine"
      }
    }

    // SourcesPopover — apparition
    sourcesPopover: {
      enter: {
        opacity: { from: 0, to: 1, duration: "short" }
        scale: { from: 0.95, to: 1, duration: "short", easing: "feminine" }
      }
    }
  }

  // ──────────────────────────────────────
  // Reduced motion
  // ──────────────────────────────────────
  reducedMotion: {
    // Si prefers-reduced-motion: reduce
    // → toutes les animations passent à instant OU micro
    overrideDurations: {
      instant: 0
      micro: 0
      short: 0
      medium: 80     // garde un soupçon pour ne pas casser le repérage visuel
      long: 80
      xlong: 80
    }
    // Animations désactivées totalement
    disabledKeys: [
      "components.typingDots.dot",      // remplacé par "..." statique
      "components.launcher.pulse",
      "components.streamingCaret"
    ]
  }

  // ──────────────────────────────────────
  // Tokens d'usage rapide
  // ──────────────────────────────────────
  presets: {
    // Pour les composants tiers ou ad-hoc
    fadeIn: {
      opacity: { from: 0, to: 1, duration: "short", easing: "standardDecel" }
    }
    slideUp: {
      translateY: { from: 12, to: 0, duration: "medium", easing: "standardDecel" }
      opacity: { from: 0, to: 1, duration: "short" }
    }
    popIn: {
      scale: { from: 0.9, to: 1, duration: "medium", easing: "feminine" }
      opacity: { from: 0, to: 1, duration: "short" }
    }
  }

  // ──────────────────────────────────────
  // Conventions d'application
  // ──────────────────────────────────────
  conventions: {
    // Tous les durées >250ms doivent être interruptibles (cancel sur hover/click)
    // Tous les éléments interactifs doivent avoir un état :hover, :focus-visible, :active
    // Pas d'animation infinite sans pause (sauf typing dots, caret)
    // Respecter prefers-reduced-motion sans exception
    // RTL : layout miroir géré par CSS dir, mais translates explicites doivent être négatives
  }
}
