@startuml AI Engine Create Page — User Flow (NEW)

!theme plain
skinparam backgroundColor #FFFFFF
skinparam ActivityBackgroundColor #FBF7F1
skinparam ActivityBorderColor #D1B799
skinparam ActivityDiamondBackgroundColor #FBF7F1
skinparam ActivityDiamondBorderColor #D1B799
skinparam ArrowColor #2F2A26
skinparam NoteBorderColor #A89D90
skinparam NoteBackgroundColor #F5F0E8

title **Page Creation AI Engine — Parcours utilisateur (NEW)**\n//avec Stepper, Parametres avances, Review toggle, Video, Publish//

|#FBF7F1| Operator |

start

partition "**ETAPE 1 — Brief**" #E8F5E9 {
  :Page loads;
  note right
    **Stepper** = [**1.Brief** | 2.Generation | 3.Review | 4.Publication]
    Phase = ""brief""
  end note

  :Fill brief form;
  note right
    **Champs principaux** (toujours visibles):
    — Objectif (select, required)
    — Plateforme (select, required)
    — Format (select, required)
    — Ton (select, required)
    — Message cle (textarea, required)
    — Focus produit (input, optional)
    — Reference tendance (input, optional)
  end note

  if (Open Advanced Params?) then (yes)
    :Expand collapsible section;
    note right
      **Parametres avances** (fermes par defaut):
      — Modele texte: [Auto | Rapide | Premium | **Personnalise**]
      — Modele image: ModelSelector (capability=image)
      — Modele video: ModelSelector (capability=video)
          //masque si format = text_post | infographic//
      — Toggle "Generer les visuels" (on/off)
      — Toggle "Review humaine" (on/off)
    end note

    if (Select model preset?) then (Personnalise)
      :Open ModelSelector (text);
      :Select specific model;
    else (Auto / Rapide / Premium)
      :Preset selected;
    endif

    if (Enable human review?) then (yes)
      :humanReviewEnabled = true;
    else (no)
      :humanReviewEnabled = false;
    endif

    :Close advanced params;
  else (no)
    :Use defaults;
    note right
      textModel = ""auto""
      imageModel = config default
      videoModel = config default
      generateVisuals = true
      humanReviewEnabled = false
    end note
  endif

  if (Form valid?) then (yes)
    :Click **Generer**;
  else (no)
    :Button disabled;
    stop
  endif
}

partition "**ETAPE 2 — Generation**" #E3F2FD {
  :POST /api/admin/ai-engine/generate;
  note right
    **Stepper** = [1.Brief(done) | **2.Generation** | 3.Review | 4.Publication]
    Phase = ""generating""
    Body includes: textModel, imageModel,
    videoModel, generateVisuals, humanReviewRequired
  end note

  :SimulateProgress animation;
  note right
    Pipeline steps:
    1. Analyse du brief
    2. Enrichissement contextuel
    3. Redaction du script
    4. Generation des visuels
    5. Controle qualite
    6. Termine
  end note

  if (API error?) then (yes)
    :Phase = ""error"";
    :Show error panel;
    note right
      Stepper keeps last valid state
      Buttons: [Reessayer | Modifier le brief]
    end note
    if (Retry?) then (yes)
      :handleRetry();
      -> POST /generate again;
    else (Modify brief)
      :handleReset();
      -> Back to brief;
    endif
    stop
  else (success)
  endif

  if (humanReviewEnabled AND status != 'review') then (client-side review)
    :Build mock reviewPayload from result;
    :Store pendingResult;
  elseif (API returns status == 'review') then (server-side review)
    :Use API reviewPayload;
  else (no review)
    :Build effectiveBridgeResult;
    note right
      If bridgeResult is null, generate
      mock IDs: mock-idea-xxx, mock-brief-xxx, mock-draft-xxx
    end note
    goto result_phase
  endif
}

partition "**ETAPE 3 — Review**" #FFF3E0 {
  :Display ReviewPanel;
  note right
    **Stepper** = [1.Brief(done) | 2.Generation(done) | **3.Review** | 4.Publication]
    Phase = ""review""

    ReviewPanel shows:
    — Script (hook, scenes, CTA)
    — Caption (full text)
    — Hashtags (chips)
    — Images (thumbnails)
    — Quality scores (bars)
  end note

  if (Decision?) then (Approve)
    :onDecision('approved');
    if (pendingResult exists?) then (mock mode)
      :Use pendingResult as final result;
      :Build effectiveBridgeResult;
    else (real API)
      :POST /api/admin/ai-engine/jobs/{id}/review;
      :Receive final result from API;
    endif
    goto result_phase
  elseif (Edit requested) then
    :Show feedback textarea;
    :onDecision('edit_requested', feedback);
    if (pendingResult?) then (mock)
      :Simulate delay;
      :Remain in review;
      -> Display ReviewPanel;
    else (real)
      :API returns new reviewPayload;
      -> Display ReviewPanel;
    endif
  else (Reject)
    :onDecision('rejected');
    if (pendingResult?) then (mock)
      :handleReset();
      -> Back to brief;
    else (real)
      :API processes rejection;
      :handleReset();
      -> Back to brief;
    endif
    stop
  endif
}

label result_phase

partition "**ETAPE 4 — Resultat & Publication**" #F3E5F5 {
  :Display GenerationResult;
  note right
    **Stepper** = [1.Brief(done) | 2.Generation(done) | 3.Review(done) | **4.Publication**]
    Phase = ""result""
  end note

  :Show Script section (CollapsibleSection, open);
  :Show Caption section (with CopyButton);
  :Show Hashtags (Badge chips);

  if (result.images non-empty?) then (yes)
    :Show Images section (CollapsibleSection);
    note right
      Grid layout, responsive,
      aspect-ratio 1:1 thumbnails
    end note
  endif

  if (result.videos non-empty?) then (yes)
    :Show **Videos** section (CollapsibleSection);
    note right
      **NEW (P4):**
      HTML5 <video> player with controls
      Badges: duration, resolution, provider
      preload="metadata"
    end note
  endif

  :Show Quality Scores (progress bars);
  :Show Cost Breakdown (table);

  :Show **PublishSection**;
  note right
    **NEW (P5):**
    Always visible (mock bridgeResult fallback)
    Badge "Mode Mock" if draftId is mock
    Mode: [Publier maintenant | Planifier]
  end note

  if (Publish mode?) then (Publier maintenant)
    :POST /api/admin/ai-engine/publish { draftId, mode: 'now' };
    :Show success message;
    note right: "Contenu publie avec succes"
  elseif (Planifier) then
    :Select datetime;
    :POST /api/admin/ai-engine/publish { draftId, mode: 'schedule', scheduledAt };
    :Show scheduled message;
    note right: "Contenu planifie pour le [date]"
  endif

  :Action buttons;
  if (Action?) then (Regenerer)
    :handleRetry();
    -> Back to generation;
  elseif (Voir dans bibliotheque) then
    :Navigate to contentStudioUrl;
    stop
  else (Utiliser ce contenu)
    :Navigate to /admin/content-studio-v2/create;
    stop
  endif
}

stop

@enduml
