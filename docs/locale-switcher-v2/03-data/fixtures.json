  "acceptLanguageFixtures": {
    "description": "Mapping Accept-Language header (+ cookie NEXT_LOCALE) → locale suggérée par resolveSuggestedLocale(). Voir 04-backend/server-detection.md pour les règles de précédence. enabledLocales par défaut = [fr,ar,en].",
    "cases": [
      {
        "name": "explicit_cookie_wins",
        "acceptLanguage": "ar-MA,ar;q=0.9,fr;q=0.5",
        "cookieNextLocale": "en",
        "servedLocale": "en",
        "expectedSuggested": null,
        "reason": "Cookie NEXT_LOCALE = choix explicite → on ne suggère rien (served == résolu). Précédence cookie > Accept-Language."
      },
      {
        "name": "arabic_browser_french_page",
        "acceptLanguage": "ar-MA,ar;q=0.9,fr;q=0.4",
        "cookieNextLocale": null,
        "servedLocale": "fr",
        "expectedSuggested": "ar",
        "reason": "Pas de cookie ; navigateur primaire = ar ≠ served fr → suggère ar (déclenche le nudge)."
      },
      {
        "name": "english_browser_french_page",
        "acceptLanguage": "en-US,en;q=0.9",
        "cookieNextLocale": null,
        "servedLocale": "fr",
        "expectedSuggested": "en",
        "reason": "Navigateur en ≠ served fr → suggère en."
      },
      {
        "name": "french_browser_french_page_noop",
        "acceptLanguage": "fr-FR,fr;q=0.9,en;q=0.5",
        "cookieNextLocale": null,
        "servedLocale": "fr",
        "expectedSuggested": null,
        "reason": "Navigateur fr == served fr → aucune suggestion."
      },
      {
        "name": "unsupported_language_falls_through",
        "acceptLanguage": "de-DE,de;q=0.9,es;q=0.7",
        "cookieNextLocale": null,
        "servedLocale": "fr",
        "expectedSuggested": null,
        "reason": "Aucune langue supportée dans l'en-tête → pas de suggestion (on ne pousse pas une langue non demandée)."
      },
      {
        "name": "quality_ordering_picks_highest_supported",
        "acceptLanguage": "de;q=1.0,ar;q=0.8,en;q=0.6",
        "cookieNextLocale": null,
        "servedLocale": "fr",
        "expectedSuggested": "ar",
        "reason": "On ignore les non-supportées (de) et on prend la supportée de plus haut q (ar 0.8 > en 0.6)."
      },
      {
        "name": "suggested_locale_disabled_no_nudge",
        "acceptLanguage": "ar-MA,ar;q=0.9",
        "cookieNextLocale": null,
        "servedLocale": "fr",
        "enabledLocales": ["fr", "en"],
        "expectedSuggested": null,
        "reason": "ar demandée mais DÉSACTIVÉE en config (valid_ar_disabled) → on ne suggère jamais une locale non servable."
      },
      {
        "name": "empty_header",
        "acceptLanguage": "",
        "cookieNextLocale": null,
        "servedLocale": "fr",
        "expectedSuggested": null,
        "reason": "En-tête vide/absent → pas de suggestion (privacy : pas de géoloc IP de secours)."
      },
      {
        "name": "wildcard_only",
        "acceptLanguage": "*",
        "cookieNextLocale": null,
        "servedLocale": "fr",
        "expectedSuggested": null,
        "reason": "Wildcard seul = aucune préférence exprimée → pas de suggestion."
      }
    ]
  }
}
