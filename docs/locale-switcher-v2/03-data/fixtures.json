      "expectValid": false,
      "violatesRules": ["V-DEFAULT-ONE"],
      "config": {
        "locales": [
          { "code": "fr", "enabled": true, "endonym": "Français", "direction": "ltr", "order": 1, "isDefault": true },
          { "code": "ar", "enabled": true, "endonym": "العربية", "direction": "rtl", "order": 2, "isDefault": true },
          { "code": "en", "enabled": true, "endonym": "English", "direction": "ltr", "order": 3 }
