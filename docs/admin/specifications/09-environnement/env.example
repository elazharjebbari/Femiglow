# =====================================================================
# FemiGlow Admin — variables d'environnement
# =====================================================================
# Copiez ce fichier vers .env.local et remplissez les valeurs.
# Ne committez JAMAIS .env.local.
# =====================================================================

# ──────────── BASE DE DONNÉES ────────────
# Neon Postgres — récupérée depuis le dashboard Neon
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/femiglow?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/femiglow?sslmode=require"

# ──────────── SESSIONS & CHIFFREMENT ────────────
# Générer avec : openssl rand -base64 32
ADMIN_SESSION_PASSWORD=""
WEBHOOK_SECRET_KEY=""
CRON_SECRET=""

# ──────────── COMPTE ADMIN INITIAL (seed only) ────────────
# Utilisé une seule fois par scripts/create-admin.ts
ADMIN_EMAIL="fondatrice@femiglow.ma"
ADMIN_PASSWORD=""           # Générer via : openssl rand -base64 24
ADMIN_NAME="Fondatrice"

# ──────────── OBSERVABILITÉ ────────────
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ──────────── APP ────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# ──────────── TESTS E2E (CI / local) ────────────
E2E_BASE_URL="http://localhost:3000"
E2E_ADMIN_EMAIL="e2e@femiglow.ma"
E2E_ADMIN_PASSWORD=""
