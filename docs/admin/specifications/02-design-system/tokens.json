{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Tokens design FemiGlow admin — extension de la palette earthen, format inspiré du W3C Design Tokens Format Module.",
  "$version": "1.0.0",
  "color": {
    "brand": {
      "creme": { "$value": "#FAF7F2", "$description": "Fond principal, surfaces" },
      "encre": { "$value": "#1F1F1A", "$description": "Texte principal, accents forts" },
      "sauge": { "$value": "#A4B5A4", "$description": "Accent organique, validations douces" },
      "petale": { "$value": "#D8B7B7", "$description": "Accent féminin, hover doux" },
      "ciel": { "$value": "#C8D6E5", "$description": "Accent cool, info" },
      "champagne": { "$value": "#E8D9B5", "$description": "Highlight, KPI" }
    },
    "neutral": {
      "encre/95": { "$value": "rgba(31, 31, 26, 0.95)" },
      "encre/80": { "$value": "rgba(31, 31, 26, 0.80)" },
      "encre/60": { "$value": "rgba(31, 31, 26, 0.60)" },
      "encre/40": { "$value": "rgba(31, 31, 26, 0.40)" },
      "encre/20": { "$value": "rgba(31, 31, 26, 0.20)" },
      "encre/10": { "$value": "rgba(31, 31, 26, 0.10)" },
      "encre/8":  { "$value": "rgba(31, 31, 26, 0.08)" },
      "encre/5":  { "$value": "rgba(31, 31, 26, 0.05)" }
    },
    "semantic": {
      "status-new":         { "$value": "{color.brand.ciel}",       "$description": "Lead non-traité" },
      "status-in-progress": { "$value": "{color.brand.champagne}",  "$description": "Lead en cours de qualification" },
      "status-converted":   { "$value": "{color.brand.sauge}",      "$description": "Lead converti, succès" },
      "status-closed":      { "$value": "{color.neutral.encre/40}", "$description": "Lead fermé, neutre" },
      "status-duplicate":   { "$value": "{color.neutral.encre/20}", "$description": "Lead doublon" },
      "delivery-pending":   { "$value": "{color.brand.champagne}",  "$description": "Livraison en attente" },
      "delivery-success":   { "$value": "{color.brand.sauge}",      "$description": "Livraison réussie" },
      "delivery-failed":    { "$value": "{color.brand.petale}",     "$description": "Livraison échouée" },
      "delivery-aborted":   { "$value": "{color.neutral.encre/40}", "$description": "Livraison abandonnée" },
      "danger":             { "$value": "#A33A3A",                  "$description": "Suppression, erreur destructive" },
      "danger-bg":          { "$value": "#F5E5E5",                  "$description": "Fond alerte rouge" }
    },
    "interactive": {
      "focus-ring": { "$value": "{color.brand.encre}", "$description": "Anneau de focus 2px" },
      "hover-bg":   { "$value": "{color.neutral.encre/5}" },
      "selected-bg":{ "$value": "{color.neutral.encre/8}" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "$value": "var(--font-cormorant), 'Cormorant Garamond', serif" },
      "body":    { "$value": "var(--font-inter), Inter, system-ui, sans-serif" },
      "mono":    { "$value": "ui-monospace, 'SF Mono', Menlo, monospace" }
    },
    "fontSize": {
      "h1":     { "$value": "2.25rem",   "$description": "36px — titres pages" },
      "h2":     { "$value": "1.75rem",   "$description": "28px — sections" },
      "h3":     { "$value": "1.25rem",   "$description": "20px — sous-sections" },
      "body":   { "$value": "0.9375rem", "$description": "15px — corps de texte" },
      "small":  { "$value": "0.8125rem", "$description": "13px — métadonnées" },
      "kicker": { "$value": "0.6875rem", "$description": "11px — surtitres uppercase" },
      "tabular":{ "$value": "0.875rem",  "$description": "14px — tableaux" }
    },
    "lineHeight": {
      "tight":  { "$value": "1.2" },
      "normal": { "$value": "1.5" },
      "loose":  { "$value": "1.7" }
    },
    "letterSpacing": {
      "tight":   { "$value": "-0.01em" },
      "normal":  { "$value": "0" },
      "kicker":  { "$value": "0.18em" },
      "tabular": { "$value": "0" }
    },
    "fontWeight": {
      "regular": { "$value": "400" },
      "medium":  { "$value": "500" },
      "semibold":{ "$value": "600" }
    }
  },
  "spacing": {
    "0":   { "$value": "0" },
    "0.5": { "$value": "0.125rem" },
    "1":   { "$value": "0.25rem" },
    "2":   { "$value": "0.5rem" },
    "3":   { "$value": "0.75rem" },
    "4":   { "$value": "1rem" },
    "5":   { "$value": "1.25rem" },
    "6":   { "$value": "1.5rem" },
    "8":   { "$value": "2rem" },
    "10":  { "$value": "2.5rem" },
    "12":  { "$value": "3rem" },
    "16":  { "$value": "4rem" },
    "20":  { "$value": "5rem" }
  },
  "radius": {
    "none": { "$value": "0" },
    "sm":   { "$value": "2px" },
    "md":   { "$value": "4px" },
    "lg":   { "$value": "8px" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "none": { "$value": "none" },
    "sm":   { "$value": "0 1px 2px rgba(31, 31, 26, 0.04)" },
    "md":   { "$value": "0 2px 6px rgba(31, 31, 26, 0.06)" },
    "lg":   { "$value": "0 8px 24px rgba(31, 31, 26, 0.08)" }
  },
  "motion": {
    "duration": {
      "instant": { "$value": "0ms" },
      "fast":    { "$value": "120ms" },
      "base":    { "$value": "200ms" },
      "smooth":  { "$value": "280ms" },
      "slow":    { "$value": "480ms" }
    },
    "easing": {
      "standard":  { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "out":       { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "in":        { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
      "emphasized":{ "$value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },
  "z-index": {
    "base":     { "$value": "0" },
    "raised":   { "$value": "10" },
    "dropdown": { "$value": "100" },
    "sticky":   { "$value": "200" },
    "modal":    { "$value": "300" },
    "toast":    { "$value": "400" }
  },
  "breakpoints": {
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  }
}
