{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/media-optimize",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/tracking-purge",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/analytics-refresh",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/promote-scheduled-fields",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/purge-field-history",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/cron/chat/purge",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/chat/billing-reset",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/chat/intent-recompute",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/chat/kb-sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/chat/budget-watch",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/chat/weekly-digest",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/admin/analytics/insights/refresh",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/insights-purge",
      "schedule": "30 3 1 * *"
    },
    {
      "path": "/api/cron/legal-link-health",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/content-studio/social-publish-scheduler",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/content-studio/insights-ingestion",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/content-studio/weekly-failure-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/tracking/capi-flush",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
