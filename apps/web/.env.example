# Public
NEXT_PUBLIC_SITE_URL=https://femiglow.ma
NEXT_PUBLIC_ENV=development

# CMS
CMS_PROVIDER=mock
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Stripe (Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email (Phase 2)
RESEND_API_KEY=

# Analytics & monitoring
PLAUSIBLE_DOMAIN=femiglow.ma
NEXT_PUBLIC_SENTRY_DSN=

# Features
B2B_ENABLED=false
MAINTENANCE_MODE=false

# === Catalogue villes de livraison (CHA-230) ===
# Kill-switch du catalogue dynamique DB → bascule sur dataset statique
# `MOROCCAN_CITIES` (~30 villes). Valeur par défaut implicite : true.
#
#   true  / unset → utilise /api/delivery-cities/search (PostgreSQL, ~50 villes,
#                   admin-managed via /admin/settings/delivery-cities).
#   false         → court-circuite la DB côté hook ET côté API route, sert le
#                   dataset statique embarqué (rollback ~5 min en cas
#                   d'incident DB).
#
# Note : c'est une variable NEXT_PUBLIC_, donc lue au build/SSR ; un redéploiement
# Vercel est nécessaire pour propager un changement de valeur.
# NEXT_PUBLIC_USE_DB_CITIES=true

# Logging (debug | info | warn | error)
LOG_LEVEL=info

# === Admin (B+A) ===

# Neon Postgres (pooled URL pour Edge/serverless, direct URL pour migrations)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.neon.tech/femiglow?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.neon.tech/femiglow?sslmode=require

# Auto-seed au boot Next.js. Sans DATABASE_URL : seed mémoire automatique.
# Avec DATABASE_URL : seed DB seulement si AUTO_SEED=1. À NE PAS activer en prod.
# AUTO_SEED=1

# iron-session (>= 32 chars, généré : openssl rand -base64 48)
ADMIN_SESSION_PASSWORD=

# AES-256-GCM master key pour les secrets webhook (>= 32 chars)
WEBHOOK_SECRET_KEY=

# Bearer attendu par /api/cron/tick (Vercel Cron header Authorization)
CRON_SECRET=

# Bootstrap superadmin (créé automatiquement au premier login si absent)
# Le mot de passe doit faire >= 8 caractères. Idempotent : ignoré si l'email existe déjà.
ADMIN_BOOTSTRAP_EMAIL=admin@femiglow.local
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Super Admin

# === Chat assistant ===
# Kill switch global. `false` = module inerte. `true` = activable et
# pilotable depuis /admin/chat (toggle runtime DB).
CHAT_ENABLED=false

# AES-256-GCM master key pour chiffrer les clés API providers en base
# (>= 32 chars, généré : openssl rand -base64 48). NE PAS changer
# après création de providers, sinon clés illisibles.
CHAT_PROVIDER_KEY=

# Budget mensuel global tous providers (€). 0 = illimité.
CHAT_TOTAL_BUDGET_EUR_MONTHLY=0

# Langue par défaut + provider par défaut au seed.
CHAT_DEFAULT_LANGUAGE=fr
CHAT_DEFAULT_PROVIDER=openai

# Rate limit (req/min/IP).
CHAT_RATE_LIMIT_PER_MIN=60

# === Content Studio ===
# Feature gate. `true` = Studio accessible, `false` = 403.
CONTENT_STUDIO_ENABLED=false

# S2.3 phase a — when `true`, hides the legacy "Uploader + créer draft"
# Postiz delivery panel from the Draft editor. The new social_publish_job
# pipeline becomes the only path to publish. Default: `false`.
CONTENT_STUDIO_LEGACY_POSTIZ_DISABLED=false

# Postiz integration (optional — Studio works without Postiz)
POSTIZ_BASE_URL=
POSTIZ_API_KEY=

# Mode de publication sociale.
#   dry_run (défaut) = publication SIMULÉE, rien n'est posté (sécurité staging).
#   live             = publication RÉELLE via Postiz sur les comptes connectés.
# ⚠️ En 'live', un clic "Publier" poste vraiment sur le réseau social.
SOCIAL_PUBLISHING_MODE=dry_run
# En mode 'live', cible un compte précis : id interne du compte social OU id
# d'intégration Postiz (récupérable via GET {POSTIZ_BASE_URL}/api/public/v1/integrations).
# Si vide, le premier compte Postiz actif de la plateforme est utilisé.
SOCIAL_PUBLISHING_DEFAULT_ACCOUNT_ID=

# Higgsfield (génération image/vidéo IA live). L'API officielle
# (platform.higgsfield.ai) exige un credential en DEUX parties KEY_ID:KEY_SECRET.
#   - soit AI_ENGINE_HIGGSFIELD_API_KEY contient déjà "KEY_ID:KEY_SECRET",
#   - soit on fournit le secret séparément via AI_ENGINE_HIGGSFIELD_API_SECRET.
# Sans le secret, la génération Higgsfield live échoue avec un message clair.
AI_ENGINE_HIGGSFIELD_API_KEY=
AI_ENGINE_HIGGSFIELD_API_SECRET=
# Hôte API (défaut officiel). Ne pas utiliser l'ancien api.higgsfield.ai (mort).
AI_ENGINE_HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# Timezone for scheduling defaults
CONTENT_STUDIO_DEFAULT_TIMEZONE=Africa/Casablanca

# OpenAI API key for text + image generation (optional — fallback to deterministic templates)
CONTENT_STUDIO_OPENAI_API_KEY=
CHAT_OPENAI_API_KEY=

# Text generation model
CONTENT_STUDIO_TEXT_MODEL=gpt-4o-mini

# Image generation: `mock` = decorative SVG-to-PNG, `openai` = DALL-E
CONTENT_STUDIO_IMAGE_PROVIDER=mock
CONTENT_STUDIO_IMAGE_MODEL=gpt-image-1-mini

# Daily generation budget cap (cents). 0 = unlimited.
CONTENT_STUDIO_DAILY_GENERATION_BUDGET_CENTS=500

# === Snapchat Conversions API ===
# Access token pour le pixel Snap CAPI v3.
# À générer dans Snap Ads Manager > Events Manager > Pixel > Conversions API.
# Fallback si capi_token absent de la table tracking_providers.
SNAP_CAPI_TOKEN=
OLLAMA_PROVIDER_KEY=82b0446ebdc84528953436fe390e724d.tSxZ8vLc9fVHMPD9vdflsvaF
