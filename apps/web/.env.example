# Public
NEXT_PUBLIC_SITE_URL=https://femiglow.ma
NEXT_PUBLIC_ENV=development

# CMS
CMS_PROVIDER=mock
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Stripe (Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email (Phase 2)
RESEND_API_KEY=

# Analytics & monitoring
PLAUSIBLE_DOMAIN=femiglow.ma
NEXT_PUBLIC_SENTRY_DSN=

# Features
B2B_ENABLED=false
MAINTENANCE_MODE=false

# Logging (debug | info | warn | error)
LOG_LEVEL=info

# === Admin (B+A) ===

# Neon Postgres (pooled URL pour Edge/serverless, direct URL pour migrations)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.neon.tech/femiglow?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.neon.tech/femiglow?sslmode=require

# Auto-seed au boot Next.js. Sans DATABASE_URL : seed mémoire automatique.
# Avec DATABASE_URL : seed DB seulement si AUTO_SEED=1. À NE PAS activer en prod.
# AUTO_SEED=1

# iron-session (>= 32 chars, généré : openssl rand -base64 48)
ADMIN_SESSION_PASSWORD=

# AES-256-GCM master key pour les secrets webhook (>= 32 chars)
WEBHOOK_SECRET_KEY=

# Bearer attendu par /api/cron/tick (Vercel Cron header Authorization)
CRON_SECRET=

# Bootstrap superadmin (créé automatiquement au premier login si absent)
# Le mot de passe doit faire >= 8 caractères. Idempotent : ignoré si l'email existe déjà.
ADMIN_BOOTSTRAP_EMAIL=admin@femiglow.local
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Super Admin

# === Chat assistant ===
# Kill switch global. `false` = module inerte. `true` = activable et
# pilotable depuis /admin/chat (toggle runtime DB).
CHAT_ENABLED=false

# AES-256-GCM master key pour chiffrer les clés API providers en base
# (>= 32 chars, généré : openssl rand -base64 48). NE PAS changer
# après création de providers, sinon clés illisibles.
CHAT_PROVIDER_KEY=

# Budget mensuel global tous providers (€). 0 = illimité.
CHAT_TOTAL_BUDGET_EUR_MONTHLY=0

# Langue par défaut + provider par défaut au seed.
CHAT_DEFAULT_LANGUAGE=fr
CHAT_DEFAULT_PROVIDER=openai

# Rate limit (req/min/IP).
CHAT_RATE_LIMIT_PER_MIN=60
