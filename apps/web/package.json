{
  "name": "@femiglow/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate-safe": "node --env-file=.env scripts/_migrate-safe.mjs",
    "db:migrate-safe:plan": "node --env-file=.env scripts/_migrate-safe.mjs --plan",
    "db:validate": "node scripts/_validate-migrations.mjs",
    "db:validate:strict": "node scripts/_validate-migrations.mjs --strict",
    "db:validate:content-studio": "node --env-file=.env scripts/validate-content-studio-schema.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:install-purchase-view": "tsx scripts/install-view-purchase-quality.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:components": "tsx scripts/seed-components.ts",
    "seed:components-fields": "tsx scripts/seed-components-fields.ts",
    "seed:components-fields:reconcile": "tsx scripts/seed-components-fields.ts -- --reconcile",
