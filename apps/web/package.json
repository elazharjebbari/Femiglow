    "tracking:plan-export": "tsx scripts/export-active-plan.ts",
    "seed:media": "tsx scripts/seed-media.ts",
    "seed:seo": "tsx scripts/seed-seo.ts",
    "seed:seo:defaults": "tsx scripts/seed-seo-defaults.ts",
    "seed:seo:defaults:reset": "tsx scripts/seed-seo-defaults.ts -- --reset",
    "seed:products": "tsx scripts/seed-products.ts",
    "seed:review-photos": "tsx scripts/seed-review-photos.ts",
    "seed:review-photos:reset": "tsx scripts/seed-review-photos.ts --reset",
    "seed:delivery-cities": "tsx scripts/seed-delivery-cities.ts",
    "seed:coupons": "tsx scripts/seed-coupons.ts",
    "seed:all": "tsx scripts/seed-admin.ts && tsx scripts/seed-seo.ts && tsx scripts/seed-products.ts && tsx scripts/seed-coupons.ts && tsx scripts/seed-delivery-cities.ts",
    "seed:full": "tsx scripts/seed-all.ts",
    "db:provision": "node scripts/_migrate-safe.mjs && tsx scripts/seed-all.ts",
    "reset": "tsx scripts/reset.ts",
    "assets:product-images": "tsx scripts/generate-product-images.ts",
    "check:field-bindings": "tsx scripts/check-field-bindings-count.ts",
    "check:event-emit-patterns": "tsx scripts/check-event-emit-patterns.ts",
    "smoke:content-studio": "node --env-file=.env --import tsx scripts/smoke-content-studio.ts",
    "backfill:traffic-source": "tsx scripts/backfill-traffic-source.ts",
    "chat:export-golden": "tsx scripts/chat-export-golden.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\""
