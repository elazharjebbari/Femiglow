    "i18n:scan-fr": "node scripts/i18n-scan-fr.mjs",
    "seed:tracking": "tsx scripts/seed-tracking.ts",
    "migrate:tracking-to-plan": "tsx scripts/migrate-tracking-to-plan.ts",
